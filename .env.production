# 生产环境配置

# OpenTelemetry 监控开关(生产环境禁用,只在开发环境用于性能调试)
VITE_ENABLE_OTEL=false

# React 组件渲染性能监控开关（生产环境禁用，只在开发环境启用）
VITE_ENABLE_PROFILER=false

# 慢渲染阈值（毫秒，超过此值的渲染会被记录）
VITE_SLOW_RENDER_THRESHOLD=500

# OA 审批系统地址
VITE_OA_BASE_URL=https://oa.lvchengfuwu.com

# OSS 桶名称（预览/下载文件接口必填）
VITE_OSS_BUCKET_NAME=eff-prd
