# 开发环境配置

# OpenTelemetry 监控开关
# 本地 pnpm dev: 禁用 (false)
# 服务器部署: Jenkins 在执行 pnpm build:dev 前设置 export VITE_ENABLE_OTEL=true
VITE_ENABLE_OTEL=false

# React 组件渲染性能监控开关
# 本地 pnpm dev: 禁用 (false)
# 服务器部署: Jenkins 在执行 pnpm build:dev 前设置 export VITE_ENABLE_PROFILER=true
VITE_ENABLE_PROFILER=false

# 慢渲染阈值（毫秒，超过此值的渲染会被记录）
VITE_SLOW_RENDER_THRESHOLD=500

# OA 审批系统地址
VITE_OA_BASE_URL=http://oatest.lcfw.co:33133

# OSS 桶名称（预览/下载文件接口必填）
VITE_OSS_BUCKET_NAME=eff-test
