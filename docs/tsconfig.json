{
	"compilerOptions": {
		"target": "ES2020",
		"jsx": "preserve",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"types": ["vitepress/client"],
		"allowJs": true,
		"strict": false,
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": [".vitepress/**/*"],
	"exclude": ["node_modules"]
}
