{
	"name": "org-efficiency-platform",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@12.14.0",
	"description": "组织效能管控平台 - 基于 React 18、TypeScript 5.8、Vite 6 和 Ant Design 5 构建的现代化企业级中后台管理系统。提供人员档案管理、智能标签体系、策略管理、系统管理等核心功能，内置权限校验、动态菜单、多主题配置、路由缓存等开箱即用功能",
	"author": "greentown-tech",
	"license": "UNLICENSED",
	"homepage": "http://git.greentown-tech.com/caizhipeng/org-efficiency-platform",
	"repository": {
		"type": "git",
		"url": "http://git.greentown-tech.com/caizhipeng/org-efficiency-platform.git"
	},
	"bugs": {
		"url": "http://git.greentown-tech.com/caizhipeng/org-efficiency-platform/issues"
	},
	"imports": {
		"#*": "./*"
	},
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=10.6.4"
	},
	"scripts": {
		"dev": "cross-env vite --host",
		"dev:local": "cross-env LOCAL_API_PROXY=true vite --host",
		"build": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" vite build",
		"build:dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" vite build --mode development",
		"build:test": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" vite build --mode test",
		"build:prod": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" vite build --mode production",
		"preview": "cross-env vite preview",
		"preview:dev": "cross-env vite preview --mode development",
		"preview:test": "cross-env vite preview --mode test",
		"preview:prod": "cross-env vite preview --mode production",
		"typecheck": "tsc --noEmit",
		"analyzer": "vite-bundle-visualizer --output analyzer/stats.html",
		"eslint-config-inspector": "eslint-config-inspector",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix --no-cache",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"prepare": "simple-git-hooks",
		"pnpm:install": "pnpm install",
		"npm-check": "taze major -lrw",
		"test": "vitest",
		"test:e2e": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build"
	},
	"dependencies": {
		"@ant-design/icons": "^6.0.0",
		"@ant-design/pro-components": "^2.8.10",
		"@antv/g6": "^5.0.51",
		"@antv/g6-extension-react": "^0.2.6",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
		"@opentelemetry/instrumentation": "^0.208.0",
		"@opentelemetry/instrumentation-document-load": "^0.54.0",
		"@opentelemetry/instrumentation-fetch": "^0.208.0",
		"@opentelemetry/instrumentation-user-interaction": "^0.53.0",
		"@opentelemetry/instrumentation-xml-http-request": "^0.208.0",
		"@opentelemetry/resources": "^2.2.0",
		"@opentelemetry/sdk-trace-base": "^2.2.0",
		"@opentelemetry/sdk-trace-web": "^2.2.0",
		"@opentelemetry/semantic-conventions": "^1.38.0",
		"@stomp/stompjs": "^7.3.0",
		"@tanstack/react-query": "^5.90.12",
		"@tanstack/react-virtual": "^3.13.23",
		"ahooks": "^3.9.6",
		"antd": "^5.27.6",
		"antd-img-crop": "^4.24.0",
		"axios": "^1.7.8",
		"big.js": "5.2.2",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.13",
		"dompurify": "^3.3.3",
		"echarts": "^6.0.0",
		"echarts-for-react": "^3.0.5",
		"i18next": "^24.2.3",
		"keepalive-for-react": "^4.0.2",
		"ky": "^1.7.5",
		"lodash-es": "^4.17.22",
		"lucide-react": "^1.17.0",
		"marked": "^17.0.1",
		"motion": "^12.5.0",
		"nprogress": "^0.2.0",
		"pinyin-pro": "^3.26.0",
		"react": "^18.3.1",
		"react-countup": "^6.5.3",
		"react-dom": "^18.3.1",
		"react-error-boundary": "^5.0.0",
		"react-i18next": "^15.4.1",
		"react-infinite-scroll-component": "^6.1.0",
		"react-jss": "^10.10.0",
		"react-resizable-panels": "^4.11.2",
		"react-router": "^7.4.0",
		"simplebar-react": "^3.3.0",
		"sockjs-client": "^1.6.1",
		"spin-delay": "^2.0.1",
		"styled-components": "^6.3.8",
		"svg-captcha": "^1.4.0",
		"tailwind-merge": "^2.6.0",
		"uuid": "^13.0.0",
		"zod": "4.2.1",
		"zustand": "^5.0.3"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^4.10.1",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@eslint-react/eslint-plugin": "^1.36.1",
		"@eslint/config-inspector": "^1.0.2",
		"@faker-js/faker": "^9.6.0",
		"@iconify-json/ri": "^1.2.5",
		"@iconify/tools": "^4.1.2",
		"@playwright/test": "^1.57.0",
		"@storybook/addon-essentials": "^8.4.7",
		"@storybook/addon-interactions": "^8.4.7",
		"@storybook/addon-links": "^8.4.7",
		"@storybook/manager-api": "^8.4.7",
		"@storybook/react": "^8.4.7",
		"@storybook/react-vite": "^8.4.7",
		"@storybook/test": "^8.6.14",
		"@storybook/theming": "^8.4.7",
		"@svgr/plugin-jsx": "^8.1.0",
		"@svgr/plugin-svgo": "^8.1.0",
		"@tanstack/react-query-devtools": "^5.69.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.2.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/big.js": "^7.0.0",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22.13.10",
		"@types/nprogress": "^0.2.3",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/sockjs-client": "^1.5.4",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.21",
		"cross-env": "^10.0.0",
		"eslint": "^9.22.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"globals": "^16.0.0",
		"happy-dom": "^17.4.4",
		"lint-staged": "^15.5.0",
		"postcss": "^8.5.3",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rollup-plugin-visualizer": "^7.1.1",
		"simple-git-hooks": "^2.11.1",
		"storybook": "^8.4.7",
		"tailwindcss": "^3.4.19",
		"taze": "^19.0.2",
		"typescript": "^5.8.2",
		"unplugin-icons": "^22.1.0",
		"vite": "^6.4.1",
		"vite-bundle-visualizer": "^1.2.1",
		"vite-plugin-checker": "^0.9.1",
		"vite-plugin-fake-server": "^2.2.0",
		"vite-plugin-svgr": "^4.3.0",
		"vitest": "^3.0.9"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged",
		"commit-msg": "npx commitlint --edit"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,tsx,json,jsonc}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,scss,less,html,md,mdx,yaml,yml}": [
			"prettier --write"
		]
	}
}
